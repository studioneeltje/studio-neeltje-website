      "props": {
        "id": "home-quote-1",
        "texts": [
          {
            "key": "0",
            "label": "Label: 01 — TUSSEN DE MOMENTEN",
            "value": "HET IS NOGAL EEN EMOTIONEEL MOMENT"
          },
          {
            "key": "1",
            "label": "Titel: Jullie beleven de",
            "value": "Je kiest een trouwfotograaf"
          },
          {
            "key": "2",
            "label": "Label: dag",
            "value": "niet alleen "
          },
          {
            "key": "3",
            "label": "Titel: . Ik zie ook wat er tussendoor",
            "value": " vanwege de "
          },
          {
            "key": "4",
            "label": "Label: gebeurt.",
            "value": "mooie foto's."
          },
          {
            "key": "5",
            "label": "Label: met liefde gezien, Neeltje",
            "value": "met liefde gezien, Neeltje"
          },
          {
            "key": "6",
            "label": "Tekst: Een trouwdag bestaat uit meer dan de grote momen",
            "value": "Iedere website staat vol met prachtige foto's. Iedere fotograaf zegt dat jullie vooral jezelf moeten zijn. Eerlijk gezegd maakt dat het kiezen niet makkelijker. Want hoe weet je nou wie écht bij jullie past? Volgens mij begint dat niet bij een portfolio. Het begint bij een veel belangrijkere vraag. Met wie willen jullie de hele dag optrekken? Want op jullie trouwdag ben ik er vaker bij dan sommige gasten."
          }
        ],
